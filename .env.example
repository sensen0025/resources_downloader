# Resource Hub — 配置
# 复制为 .env 后填写(注意:邮箱密码处填「授权码/应用专用密码」,不是登录密码)

# ---- 邮箱收码技能(skills/mail)----
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_EMAIL=you@example.com
MAIL_PASSWORD=your_app_password_or_auth_code
MAIL_FOLDER=INBOX
MAIL_TIMEOUT=30

# ---- LLM(AI Agent 驱动,账号注册器/登录器)----
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# ---- 可选 VLM 兜底(本地 Ollama 图形验证码)----
# CAPTCHA_VLM_URL=http://localhost:11434/v1/chat/completions
# CAPTCHA_VLM_MODEL=qwen2.5-vl:7b

# ---- 下载安全查毒技能(skills/security)----
# 引擎1:ClamAV(开源杀毒,推荐)。安装后先 freshclam 更新病毒库,再启动 clamd 守护进程
#   Windows: winget install Cisco.ClamAV
#   macOS:   brew install clamav
#   Ubuntu:  sudo apt install clamav clamav-daemon
# clamd 常驻内存扫描最快(INSTREAM 协议);没装 clamd 时自动回退 clamscan 命令行
SECURITY_CLAMD_HOST=127.0.0.1
SECURITY_CLAMD_PORT=3310
# SECURITY_CLAMD_SOCKET=/var/run/clamav/clamd.ctl   # unix socket(Linux/macOS),非空优先
# SECURITY_CLAMSCAN_PATH=                            # 空=自动在 PATH/常见位置找 clamscan
# 引擎2:YARA 规则(可选,需 pip install yara-python)
# SECURITY_YARA_RULES_DIR=                           # 空=用内置 rules/;多个目录用 ; 分隔
# 引擎3:内置启发式(纯标准库,永远可用):魔法字节伪装/压缩炸弹/脚本载荷/双重扩展名
SECURITY_HEURISTIC_ENABLED=1
SECURITY_TIMEOUT=60
SECURITY_STRICT=1   # suspicious 是否判失败(安全闸门默认严格)

# ---- VPN/代理(可选,通用模板:晨涧云学术代理 proxy.mornai.cn:7890)----
# 只对「资源获取链路」生效(search 多引擎检索 / pages 页面抓取 / delivery 文件下载 /
# agent/browser 浏览器 Agent);LLM API 与 Webhook 回调保持直连,不建议全局代理。
# 优先级: RH_PROXY_URL > HTTPS_PROXY/https_proxy > HTTP_PROXY/http_proxy
RH_PROXY_URL=http://proxy.mornai.cn:7890
# 等价标准变量写法(requests/curl/wget/git 原生识别,二选一即可):
# http_proxy=http://proxy.mornai.cn:7890
# https_proxy=http://proxy.mornai.cn:7890
# no_proxy=localhost,127.0.0.1
